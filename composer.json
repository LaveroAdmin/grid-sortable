{
    "name": "laveroadmin/grid-sortable",
    "description": "Sort the grid data by drag and drop rows for LaveroAdmin",
    "type": "library",
    "keywords": ["lavero-admin", "extension", "grid", "sortable"],
    "homepage": "https://github.com/LaveroAdmin/grid-sortable",
    "license": "MIT",
    "authors": [
        {
            "name": "Aleksandr Kireev",
            "email": "hello@bespredel.name",
            "homepage": "https://bespredel.name"
        }
    ],
    "require": {
        "php": ">=7.3.0",
        "laravel/framework": "^7.0|^8.0|^9.0|^10.0|^11.0|^12.0|^13.0",
        "laveroadmin/laveroadmin": "^1.0",
        "spatie/eloquent-sortable": "^3.11|^4.0|^5.0"
    },
    "require-dev": {
        "phpunit/phpunit": "~6.0"
    },
    "autoload": {
        "psr-4": {
            "LaveroAdmin\\Admin\\GridSortable\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "LaveroAdmin\\Admin\\GridSortable\\GridSortableServiceProvider"
            ]
        }
    }
}
